# Obsidian MCP Server Environment Variables
# Copy this file to .env and customize for your environment

# Server port (default: 3000)
PORT=3000

# Path to your Obsidian vault
# For Docker: this is the container path (usually /vault)
# For local dev: use the full path to your vault
VAULT_PATH=/vault

# Node environment (development or production)
NODE_ENV=production

# Enable compact responses for token optimization (40-60% smaller)
# Set to "true" to enable minified response keys
COMPACT_RESPONSES=false

# API key for authentication (optional)
# When set, all /sse and /message endpoints require authentication.
# Clients authenticate with the Authorization header: "Bearer your-secret-key".
# (The ?api_key= query parameter was removed in 1.6.0: it leaks into access logs.)
# If not set or empty, authentication is disabled.
# API_KEY=your-secret-key-here

# Optional second factor when the server sits behind `tailscale serve` on loopback:
# require the Tailscale-User-Login header that serve adds for tailnet users to equal this login.
# Only meaningful when the container is reachable solely through `tailscale serve`.
# REQUIRE_TAILSCALE_LOGIN=you@example.com

# Seconds between SSE comment pings on GET /sse streams (0 disables). Some clients drop a
# stream that carries no bytes for about five minutes and reconnect without re-initializing.
# SSE_KEEPALIVE_SECONDS=30

# ---------------------------------------------------------------------------
# Semantic search (optional). Leave DATABASE_URL unset to disable entirely:
# no tools are registered and nothing connects anywhere.
# ---------------------------------------------------------------------------

# Postgres with the pgvector extension. The schema is created on first start.
# DATABASE_URL=postgres://brain:password@brain-db:5432/brain

# Ollama server for embeddings and the model to use. The embedding dimension is
# discovered from the model; a later change of model refuses to run until
# `node dist/indexer.js --reindex`.
# OLLAMA_URL=http://ollama:11434
# EMBED_MODEL=nomic-embed-text

# Several vaults can share one database; each indexer and server pair names its
# collection. Default: "default".
# INDEX_COLLECTION=secondbrain

# Indexer only: seconds between vault scans (default 60, minimum 5).
# INDEX_INTERVAL_SECONDS=60

# Indexer only: log every indexed/removed file (default: only pass summaries).
# INDEX_VERBOSE=false

# Texts per Ollama request (default 16).
# EMBED_BATCH_SIZE=16

# Tests and dry runs only: a deterministic in-process embedder (no model).
# EMBED_PROVIDER=fake
# EMBED_DIM=64

# Optional learn log: disabled by default. Requires semantic search and a readable
# redaction patterns file when enabled; invalid configuration disables logging.
# LEARN_LOG=false
# LEARN_RETENTION_DAYS=30
# LEARN_REDACT_PATTERNS_FILE=/config/redact-patterns.txt

# Report-only maintenance worker (node dist/maintain.js [--dry]).
# Requires DATABASE_URL and VAULT_PATH, plus an existing output directory unless dry.
# MAINTAIN_REPORT_DIR=/reports
# MAINTAIN_REPORT_VAULT_DIR=
# MAINTAIN_TZ=UTC
# MAINTAIN_LINK_COSINE=0.85
# MAINTAIN_DUP_COSINE=0.92
# MAINTAIN_DUP_TITLE_SIM=0.6
# MAINTAIN_HUB_DAYS=14
# MAINTAIN_SUMMARY_DROP=0.05
# MAINTAIN_MAX_PER_CLASS=10
