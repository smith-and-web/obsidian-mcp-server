# Obsidian MCP Server Environment Variables
# Copy this file to .env and customize for your environment

# Server port (default: 3000)
PORT=3000

# Path to your Obsidian vault
# For Docker: this is the container path (usually /vault)
# For local dev: use the full path to your vault
VAULT_PATH=/vault

# Node environment (development or production)
NODE_ENV=production

# Enable compact responses for token optimization (40-60% smaller)
# Set to "true" to enable minified response keys
COMPACT_RESPONSES=false

# API key for authentication (optional)
# When set, all /sse and /message endpoints require authentication.
# Clients can authenticate via:
#   - Authorization header: "Bearer your-secret-key"
#   - Query parameter: ?api_key=your-secret-key
# If not set or empty, authentication is disabled.
# API_KEY=your-secret-key-here
