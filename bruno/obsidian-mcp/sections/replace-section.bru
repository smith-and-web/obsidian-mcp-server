meta {
  name: Replace Section
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "replace-section",
      "arguments": {
        "path": "test-note.md",
        "heading": "## Summary",
        "content": "This is the new summary content."
      }
    }
  }
}

docs {
  Replace all content under a specific markdown heading.
}
