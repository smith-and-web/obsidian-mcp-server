meta {
  name: Read Note
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "read-note",
      "arguments": {
        "path": "test-note.md"
      }
    }
  }
}

docs {
  Read the contents of a note.

  Set `frontmatterOnly: true` to get just the YAML frontmatter as JSON.
}
