meta {
  name: List Vault
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "list-vault",
      "arguments": {
        "directory": ""
      }
    }
  }
}

docs {
  List files and directories in the vault root or a specific directory.
}
