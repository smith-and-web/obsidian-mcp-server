meta {
  name: Create Directory
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "create-directory",
      "arguments": {
        "path": "new-folder"
      }
    }
  }
}

docs {
  Create a new directory in the vault.
}
