meta {
  name: Get Backlinks
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "get-backlinks",
      "arguments": {
        "path": "test-note.md",
        "directory": ""
      }
    }
  }
}

docs {
  Find all notes that link TO a specific note (reverse link lookup).
}
