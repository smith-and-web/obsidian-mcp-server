meta {
  name: Add Tags
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "add-tags",
      "arguments": {
        "path": "test-note.md",
        "tags": ["project/active", "priority/high"],
        "location": "frontmatter"
      }
    }
  }
}

docs {
  Add tags to a note. Default adds to frontmatter. Use location="inline" for #tag syntax.
}
