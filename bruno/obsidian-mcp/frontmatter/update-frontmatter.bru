meta {
  name: Update Frontmatter
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/sse
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "update-frontmatter",
      "arguments": {
        "path": "test-note.md",
        "updates": {
          "status": "complete",
          "priority": 1
        },
        "createIfMissing": true
      }
    }
  }
}

docs {
  Update specific fields in frontmatter. Set a field to null to remove it.
}
